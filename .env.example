# Copy to .env.local

# BirdNET-Go web UI URL (default port 8080)
BIRDNET_BASE_URL=http://localhost:8080

# BirdNET-Go audio clips server URL (default port 8091)
# Server-side only — clips are proxied through /api/clips to the browser
BIRDNET_CLIPS_URL=http://localhost:8091

# xeno-canto v3 API key (https://xeno-canto.org/account)
XENOCANTO_API_KEY=

# BirdWeather station token and coordinates (for /crosscheck page)
BIRDWEATHER_TOKEN=
BIRDNET_LAT=
BIRDNET_LON=

# Optional HTTP Basic auth credentials
# BIRDNET_USERNAME=
# BIRDNET_PASSWORD=
